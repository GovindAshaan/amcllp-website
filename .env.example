# Google Search Console verification (web.meta tag method)
# Token comes from Search Console > Settings > Verification. Do not commit the real value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<your-google-verification-token>

# IndexNow (Bing + AI crawlers) - key is a lowercase-alnum string; publish /<KEY>.txt on the host
INDEXNOW_KEY=<your-indexnow-key>